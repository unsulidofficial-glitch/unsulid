{
  "name": "unsulid",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=api",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "start": "npm run start:prod --workspace=api",
    "start:prod": "npm run start:prod --workspace=api",
    "start:api": "npm run start:prod --workspace=api",
    "start:web": "npm run start --workspace=web",
    "prisma:generate": "npm run prisma:generate --workspace=api"
  }
}