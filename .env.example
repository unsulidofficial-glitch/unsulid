# ==============================================================================
# UNSULID® Fine Fragrances — Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon Free Serverless)
# ------------------------------------------------------------------------------
# Get your free PostgreSQL connection string at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER & SECURITY SECRETS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
SESSION_SECRET="generate_a_random_32_character_string_here"
JWT_SECRET="generate_a_random_64_character_string_here"
JWT_EXPIRES_IN="7d"

# CORS & URLs
FRONTEND_URL="https://your-unsulid-storefront.vercel.app"
BACKEND_URL="https://your-unsulid-api.onrender.com"

# ------------------------------------------------------------------------------
# 3. OTP & SMS GATEWAY
# ------------------------------------------------------------------------------
# Provider: 'console' (for free local testing) or 'fast2sms' / 'msg91'
OTP_PROVIDER="console"
OTP_PROVIDER_API_KEY=""
FAST2SMS_OTP_ID=""

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 5. LOGISTICS & SHIPPING (Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="logistics@unsulid.com"
SHIPROCKET_PASSWORD="your_password"
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET="your_shiprocket_webhook_secret"

# ------------------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@unsulid.com"
INITIAL_ADMIN_PASSWORD="Admin@Unsulid2026!"
INITIAL_ADMIN_NAME="UNSULID Super Admin"

